# ==============================================================================
# TOPOPOSTER STUDIO HD — CLÉS D'API OPTIONNELLES
# ==============================================================================
# Ce fichier sert de modèle. Si vous utilisez un bundler ou serveur local :
# 1. Copiez ce fichier sous le nom '.env' (ignoré par Git)
# 2. Renseignez vos clés gratuites ci-dessous
#
# IMPORTANT : L'application fonctionne 100% GRATUITEMENT sans aucune clé !
# Ces clés permettent simplement de débloquer des couches supplémentaires.
# ==============================================================================

# Mapbox Access Token (Compte gratuit : 50 000 requêtes/mois)
# Inscription gratuite : https://account.mapbox.com/
VITE_MAPBOX_TOKEN=pk.votre_cle_mapbox_ici

# Stadia Maps / Stamen (Compte gratuit : 200 000 requêtes/mois)
# Inscription gratuite : https://client.stadiamaps.com/
VITE_STADIA_KEY=votre_cle_stadia_ici

# CARTO API Key (Compte gratuit pour dalles Voyager / Dark)
# Inscription gratuite : https://carto.com/
VITE_CARTO_KEY=votre_cle_carto_ici

# IGN Géoplateforme (Optionnel si accès restreint)
VITE_IGN_KEY=
